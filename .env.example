# Local development only. npm run setup:local replaces the token placeholders.
DATABASE_URL=postgresql://daildex:local-development-only@127.0.0.1:55432/daildex
MIGRATION_DATABASE_URL=postgresql://daildex:local-development-only@127.0.0.1:55432/daildex
DATABASE_POOL_SIZE=5
PORT=8787
PUBLIC_API_BASE_URL=http://127.0.0.1:8787
# Your own frontend's base URL for confirmation and management links.
APP_BASE_URL=http://localhost:3000
TOKEN_HASH_PEPPER=replace-with-random-secret
INTERNAL_API_TOKEN=replace-with-random-secret
DAILDEX_AGENT_TOKEN=replace-with-random-secret
DAILDEX_INTERNAL_API_URL=http://127.0.0.1:8787
EMAIL_REPLY_DOMAIN=reply.example.test
INGEST_CHAMBERS=dail,seanad

# Optional outbound email: supply your own verified Resend account and domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
EMAIL_SENDING_ENABLED=false

# Optional model workflows. These stay disabled during local API setup.
OPENROUTER_API_KEY=
HERMES_ALERTS_ENABLED=false
HERMES_REPLIES_ENABLED=false
EDITORIAL_GENERATION_ENABLED=false
BUDGET_LIVE_ENABLED=false
ALERT_AUTO_PUBLISH=false
# Configure these only after setting up your own Hermes server; see docs/workers.md.
HERMES_API_BASE_URL=http://127.0.0.1:8642
HERMES_API_KEY=
HERMES_MODEL_PROVIDER=openrouter
HERMES_MODEL=inclusionai/ling-3.0-flash-vl
HERMES_ALLOWED_PROVIDERS=openrouter
HERMES_ALLOWED_MODELS=inclusionai/ling-3.0-flash-vl
HERMES_DRAFT_MODE=prompt_json
