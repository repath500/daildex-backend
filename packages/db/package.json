    "check": "tsx --env-file-if-exists=../../.env.local src/cli/check.ts"
  },
  "dependencies": {
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.20.6",
    "typescript": "^5"
  },
  "license": "MIT"
}
